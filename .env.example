# --- Core ---
ENV=local
LOG_LEVEL=INFO

# --- CORS (fails closed: empty = no cross-origin access at all) ---
# Comma-separated list of allowed origins, e.g. https://erp.example.com,https://showcase.example.com
CORS_ALLOWED_ORIGINS=

# --- Auth ---
# Comma-separated name:key pairs, e.g. erp:supersecretkey,showcase:anothersecret
API_KEYS=erp:changeme,showcase:changeme
ADMIN_API_KEY=changeme-admin-key

# --- Redis (must be an AOF-enabled instance; live job read path) ---
REDIS_URL=redis://redis:6379/0

# --- Google Sheets (durable job log + prompt matrix) ---
GOOGLE_SHEET_ID=your-google-sheet-id
# Base64 of the full service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json

# --- Google Drive (storage adapter) ---
# Only required if STORAGE_BACKEND=drive below. Not the active backend
# (supabase is) -- leave unset otherwise.
GDRIVE_FOLDER_ID=

# --- Local storage (Phase 1 storage adapter) ---
LOCAL_STORAGE_DIR=./data/storage

# --- Supabase Storage (storage adapter) ---
# Chosen over Google Drive: a service account has zero storage quota on a
# personal (non-Workspace) Drive, blocking uploads outright. Required only
# when STORAGE_BACKEND=supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=your-bucket-name

# --- Storage backend: local | drive | supabase ---
STORAGE_BACKEND=local

# --- Gemini (classification) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
CLASSIFIER_CONFIDENCE_THRESHOLD=0.75

# --- Provider (generation) ---
# HIGGSFIELD_API_KEY is optional when ENV=local
HIGGSFIELD_API_KEY=your-higgsfield-api-key
# PLACEHOLDER -- unconfirmed real Higgsfield API base URL, see
# phases/phase-4-provider-integration.md "Manual Verification".
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
PROVIDER=higgsfield
# Testing/showcase-only: only used when PROVIDER=higgsfield_mcp_bridge (a local
# MCP bridge sidecar giving real Higgsfield generations without an API key).
HIGGSFIELD_MCP_BRIDGE_URL=http://127.0.0.1:8799
# Test/dev-only failure injection for FakeProvider: submit|poll|timeout|none
FAKE_FAIL_MODE=none

# --- Limits & timing ---
MAX_IMAGE_BYTES=15728640
JOB_DEADLINE_SECONDS=900
DEDUPE_WINDOW_SECONDS=86400
MATRIX_CACHE_TTL=300
WORKER_CONCURRENCY=4
DAILY_GENERATION_CAP=200
RATE_LIMIT_PER_MINUTE=60
# Separate, more generous limit for GET /jobs/{id} polling only (Phase 7 — R20)
POLLING_RATE_LIMIT_PER_MINUTE=180

# --- Observability (Phase 8) ---
SENTRY_DSN=

# --- Free-tier deploy path only (Phase 9) ---
# true = run the ARQ worker loop in-process inside the API process. See
# docs/deployment-free-tier.md. Leave false/unset for Railway/Compose.
WORKER_IN_PROCESS=false
